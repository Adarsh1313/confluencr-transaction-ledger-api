{
  "name": "transaction-ledger-api",
  "version": "1.0.0",
  "description": "Transaction Ledger API: accounts, credits, debits, transfers",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adarsh1313/confluencr-transaction-ledger-api.git"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Adarsh1313/confluencr-transaction-ledger-api/issues"
  },
  "homepage": "https://github.com/Adarsh1313/confluencr-transaction-ledger-api#readme",
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
